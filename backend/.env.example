# ── Firebase Admin SDK ──────────────────────────────────────────
# Path to your Firebase Admin SDK service account JSON file.
# Download from: Firebase Console → Project Settings → Service Accounts → Generate new private key
GOOGLE_APPLICATION_CREDENTIALS=./firebase-adminsdk.json
FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app

# ── MongoDB ──────────────────────────────────────────────────────
# Replace with your actual MongoDB URI
MONGO_URI=mongodb://localhost:27017/vaultify

# ── Email (SMTP) ─────────────────────────────────────────────────
# SMTP settings for sending OTP emails
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=Vaultify <your-email@gmail.com>

# ── Optional ─────────────────────────────────────────────────────
# POPPLER_PATH=C:/path/to/poppler/bin

# ── Resend (Alternative Email Service - Commented Out) ────────────
# RESEND_API_KEY=your-resend-api-key
# RESEND_FROM=Vaultify <onboarding@resend.dev>
